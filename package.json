{
  "name": "SMs",
  "version": "1.0.0",
  "description": "employee-management-system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start-dev": "nodemon server.js",
    "dev": "concurrently \"npm run start-dev\" \"npm run dev --prefix client\"",
    "build": "npm install --prefix client && npm run build --prefix client"
  },
  "type": "module",
  "author": "natco",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0"
  },
  "nodemonConfig": {
    "ignore": [
      "client/**/*"
    ]
  }
}
